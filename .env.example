# ===== JWT (جلسات المنصة — sign / verify عبر shared/middleware/auth) =====
ERVENOW_JWT_SECRET=change_this_super_secret_key

# ===== SERVER =====
PORT=4000
NODE_ENV=development

# ===== SECURITY (نفس ERVENOW_INTERNAL_KEY في كبسار-backend) =====
INTERNAL_API_KEY=ضع_نفس_قيمة_ERVENOW_INTERNAL_KEY_في_كبسار

# ===== PUBLIC =====
ERVENOW_PUBLIC_URL=http://localhost:4000

# ===== TWILIO WhatsApp (Driver Notifications / OTP) =====
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ===== SUPABASE إلخ — أضِف عندك =====
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_ANON_KEY=

# عند 1: POST /api/order/create وسلة checkout تفرض draft حتى يُؤكَّد الدفع؛ payment_status=paid على الطلب لإيداع محفظة المتجر.
# بدون القيمة: الطلبات بـ payment_status=pending والتوصيل يعمل كالسابق، ولا إيداع محفظة حتى paid.
# ERVENOW_REQUIRE_ORDER_PAYMENT=1
# اختياري لاحقاً مع بوابة الدفع: payment_method في الجسم = mada | stcpay | cash
