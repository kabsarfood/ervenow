# ===== JWT (جلسات المنصة — sign / verify عبر shared/middleware/auth) =====
ERVENOW_JWT_SECRET=change_this_super_secret_key

# ===== تشفير بيانات الحساب البنكي (مندوبين / متاجر — AES-256-CBC على الخادم) =====
# الإنتاج: مطلوب صراحةً، 16 حرفاً على الأقل.
# التطوير: إن لم تُعرّفه وكان ERVENOW_JWT_SECRET طويلاً (16+) يُشتق مفتاح مؤقت مع تحذير في السجل.
# إن احتوت القيمة على # ضعها بين علامتي اقتباس وإلا dotenv يقطعها عند # (مثال: BANK_DATA_SECRET="xxxx#yyyy").
# BANK_DATA_SECRET=

# ===== SERVER =====
PORT=4000
NODE_ENV=development

# ===== FINANCE (مصدر مالي وحيد) =====
# ledger_only = ervenow_ledger_* فقط — لا wallets / driver_wallets / ervenow_wallets
FINANCE_MODE=ledger_only

# ===== SECURITY (نفس ERVENOW_INTERNAL_KEY في كبسار-backend) =====
INTERNAL_API_KEY=ضع_نفس_قيمة_ERVENOW_INTERNAL_KEY_في_كبسار

# ===== PUBLIC =====
ERVENOW_PUBLIC_URL=http://localhost:4000

# ===== OTP (إنتاج — جدول Supabase، ليس ذاكرة العملية) =====
ERVENOW_OTP_BACKEND=supabase
# ERVENOW_OTP_PEPPER=32_char_random_secret_not_jwt
# ERVENOW_OTP_ALLOW_MEMORY=1

# ===== Pre-registration / public ordering (افتراضي مغلق) =====
PUBLIC_ORDERING_ENABLED=false
SOCKET_IO_SINGLE_INSTANCE_REQUIRED=true

# ===== Redis (BullMQ — اختياري للطابور؛ OTP لا يعتمد عليه) =====
# REDIS_URL=redis://default:password@host:6379
# npm run worker:delivery

# ===== بوابة سداد الديون (Pay Link) =====
# PAYMENT_GATEWAY=moyasar
# PAYMENT_GATEWAY=mock
# MOYASAR_SECRET_KEY=
# MOYASAR_PUBLISHABLE_KEY=
# PAY_WEBHOOK_SECRET=
# PAY_MOCK_WEBHOOK_SECRET=dev_mock_secret

# ===== OTP للتطوير (معطّل افتراضياً — لا تفعّل في الإنتاج) =====
# ALLOW_DEV_OTP=true
# ERVENOW_DEV_OTP_CODE=1977

# ===== TWILIO WhatsApp (Driver Notifications / OTP) =====
# الثلاثة مطلوبة لإرسال OTP عبر واتساب:
# TWILIO_ACCOUNT_SID=ACxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxx
# TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
# (بديل: TWILIO_WHATSAPP_FROM — نفس الصيغة)
# Sandbox: المستلم يرسل join <كود> إلى رقم Sandbox قبل استلام OTP.
# خطأ 63038 = تجاوز الحد اليومي (Trial ~50/يوم) — انتظر 24 ساعة أو رقِّ الحساب.
# SUPABASE_DB_URL: إن كانت كلمة المرور فيها # أو @ ضع الرابط بين علامتي اقتباس.

# ===== ERVENOW DELIVERY ENGINE 1.0 (افتراضي معطّل) =====
# DELIVERY_ENGINE_POLICY=true
# DELIVERY_ENGINE_PRECART=true
# DELIVERY_ENGINE_CHECKOUT=true
# DELIVERY_ENGINE_STORE_OTP=true

# ===== SUPABASE إلخ — أضِف عندك =====
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_ANON_KEY=
# Windows / Node 24: npm start يشغّل الخادم بـ --use-system-ca (شهادات SSL لـ Supabase).
# إن شغّلت node server/server.js يدوياً وفشل fetch: node --use-system-ca server/server.js
# لتنفيذ migrations من الطرفية (مثل platform_settings): كلمة مرور Postgres من Dashboard → Database → URI
# SUPABASE_DB_URL=postgresql://postgres:YOUR_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
# أو: SUPABASE_DB_PASSWORD=YOUR_PASSWORD

# عند 1: POST /api/order/create وسلة checkout تفرض draft حتى يُؤكَّد الدفع؛ payment_status=paid على الطلب لإيداع محفظة المتجر.
# بدون القيمة: الطلبات بـ payment_status=pending والتوصيل يعمل كالسابق، ولا إيداع محفظة حتى paid.
# ERVENOW_REQUIRE_ORDER_PAYMENT=1
# اختياري لاحقاً مع بوابة الدفع: payment_method في الجسم = mada | stcpay | cash

# ===== ERVENOW PAY (شحن STC Pay — يُعرض في wallet.html) =====
# ERVENOW_STC_PAY_NUMBER=0505745650
# في production: لن يستمع إلا إذا عُيّن 1 (يُفضّل عدم التشغيل على الإنترنت العام).
# ERVENOW_WALLET_STANDALONE_SERVER=1
# ERVENOW_WALLET_STANDALONE_HOST=127.0.0.1
# ERVENOW_WALLET_STANDALONE_PORT=9000
