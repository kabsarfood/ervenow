{
  "name": "ervenow-platform",
  "version": "2.0.0",
  "description": "ERVENOW — Platform Core: modular gateway + apps (delivery, food, market, services)",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "dev": "node server/server.js",
    "worker:delivery": "node workers/deliveryWorker.js",
    "apply:store-branding": "node scripts/apply-store-branding-infra.mjs",
    "frontend:sync": "node scripts/sync-ervenow-frontend.js",
    "load:test": "npx artillery run tests/load/artillery.yml",
    "test": "jest",
    "test:ci": "jest --ci",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run test:e2e",
    "migrate:platform-settings": "node scripts/run-migration-platform-settings.js",
    "migrate:users-name-optional": "node scripts/run-migration-users-name-optional.js",
    "responsive:audit": "node scripts/apply-responsive-audit.js",
    "migrate:wallet-topup-pay": "node scripts/run-migration-wallet-topup-pay.js",
    "migrate:stores-steps-10-15": "node scripts/run-migration-stores-steps-10-15.js",
    "migrate:finance:bundle": "node scripts/bundle-finance-migrations.js",
    "migrate:finance": "node scripts/run-finance-migrations.js",
    "migrate:ervenow-pay-checkout": "node scripts/run-migration-ervenow-pay-checkout.js",
    "migrate:hero-banners": "node scripts/run-migration-hero-banners.js",
    "migrate:hero-banners-kind": "node scripts/run-migration-hero-banners-kind.js",
    "migrate:hero-banners-placement": "node scripts/run-migration-hero-banners-placement.js",
    "migrate:hero-banners-v2": "node scripts/run-migration-hero-banners-v2.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "bullmq": "^5.76.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^8.4.1",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "opossum": "^9.0.0",
    "pdfkit": "^0.15.2",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.1",
    "twilio": "^5.13.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "artillery": "^2.0.31",
    "jest": "^29.7.0",
    "pg": "^8.20.0",
    "supabase": "^2.98.2"
  }
