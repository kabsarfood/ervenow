{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/admin/branding",
      "dest": "/admin-branding.html"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}